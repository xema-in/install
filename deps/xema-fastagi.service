[Unit]
Description=Xema FastAGI service
  
[Service]
# Readiness is signalled by the app itself (AddSystemd).
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /var/lib/xema/fastagi/FastAGI.dll
WorkingDirectory=/var/lib/xema/fastagi
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-fastagi
PrivateTmp=true
  
[Install]
WantedBy=multi-user.target
