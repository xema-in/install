[Unit]
Description=Xema FastAGI service
  
[Service]
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /opt/techsudoku/xema/fastagi/FastAGI.dll
WorkingDirectory=/opt/techsudoku/xema/fastagi
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-fastagi
PrivateTmp=true
  
ConfigurationDirectory=xema
StateDirectory=xema/fastagi
Environment=XEMA_CONFIG_DIR=/etc/xema
Environment=XEMA_SERVICE=fastagi

[Install]
WantedBy=multi-user.target
