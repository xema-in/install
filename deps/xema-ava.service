[Unit]
Description=Xema Ava AI Agent service
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /opt/techsudoku/xema/ava/Ava.dll
WorkingDirectory=/opt/techsudoku/xema/ava
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-ava
PrivateTmp=true

ConfigurationDirectory=xema
StateDirectory=xema/ava
Environment=XEMA_CONFIG_DIR=/etc/xema
Environment=XEMA_SERVICE=ava

[Install]
WantedBy=multi-user.target
