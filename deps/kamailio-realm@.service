[Unit]
# One SIP proxy per carrier realm, instantiated as kamailio-realm@<realm>.service.
#
# The proxy runs inside the realm's own network namespace. That is what lets every realm's proxy
# listen on 5060 at the same time, alongside the phone system doing the same on the server
# itself — each namespace has its own set of ports.
#
# Deliberately has no [Install] section and is never enabled. The Manager starts and stops these
# as realms are created and removed, and rebuilds them at boot, because the namespace this binds
# to does not exist until the Manager has built it. Enabled, systemd would race the Manager at
# every boot and fail until it caught up.
#
# It is also deliberately not ordered after xema-manager.service. The Manager starts this from
# inside its own startup, so ordering it after the Manager makes the start job queue behind a
# unit that is still activating — the job then times out, and is cancelled outright if the
# Manager is restarted while it waits.
Description=SIP proxy for the %i carrier realm
Documentation=https://xema.local/help/network-realm

[Service]
Type=forking
NetworkNamespacePath=/var/run/netns/realm-%i

PIDFile=/run/kamailio-realm/%i.pid
RuntimeDirectory=kamailio-realm
RuntimeDirectoryPreserve=yes

ExecStart=/usr/sbin/kamailio \
    -f /etc/kamailio/realms/%i.cfg \
    -P /run/kamailio-realm/%i.pid \
    -m 64 -M 8 \
    -u kamailio -g kamailio

Restart=on-failure
RestartSec=5s
