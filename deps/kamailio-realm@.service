[Unit]
# One SIP proxy per carrier realm, instantiated as kamailio-realm@<realm>.service.
#
# The proxy runs inside the realm's own network namespace. That is what lets every realm's proxy
# listen on 5060 at the same time, alongside the phone system doing the same on the server
# itself — each namespace has its own set of ports.
#
# The namespace is built by the Manager, not by this unit, because it holds the carrier's
# interface and addressing. If it is missing the proxy has nothing to bind and will not start,
# which is the correct outcome: the realm is what is broken, not the proxy.
Description=SIP proxy for the %i carrier realm
Documentation=https://xema.local/help/network-realm

After=network-online.target xema-manager.service
Wants=network-online.target

[Service]
Type=forking
NetworkNamespacePath=/var/run/netns/realm-%i

PIDFile=/run/kamailio-realm/%i.pid
RuntimeDirectory=kamailio-realm
RuntimeDirectoryPreserve=yes

ExecStart=/usr/sbin/kamailio \
    -f /etc/kamailio/realms/%i.cfg \
    -P /run/kamailio-realm/%i.pid \
    -m 64 -M 8 \
    -u kamailio -g kamailio

Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
