[Unit]
Description=Xema Queue service
After=network-online.target asterisk.service rabbitmq-server.service
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /opt/techsudoku/xema/queue/Queue.dll
WorkingDirectory=/opt/techsudoku/xema/queue
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-queue
PrivateTmp=true

ConfigurationDirectory=xema
StateDirectory=xema/queue
Environment=XEMA_CONFIG_DIR=/etc/xema
Environment=XEMA_SERVICE=queue

[Install]
WantedBy=multi-user.target
