[Unit]
Description=Xema Sipper SIP capture service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /opt/techsudoku/xema/sipper/Sipper.dll
WorkingDirectory=/opt/techsudoku/xema/sipper
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-sipper
PrivateTmp=true
# Raw packet capture needs CAP_NET_RAW (and CAP_NET_ADMIN for promiscuous mode).
# Effective as root already; these also cover running under a non-root User=.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN

ConfigurationDirectory=xema
StateDirectory=xema/sipper
Environment=XEMA_CONFIG_DIR=/etc/xema
Environment=XEMA_SERVICE=sipper

[Install]
WantedBy=multi-user.target
