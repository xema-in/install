[Unit]
Description=Xema Metrics service (live dashboard hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /opt/techsudoku/xema/metrics/Metrics.dll
WorkingDirectory=/opt/techsudoku/xema/metrics
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-metrics
PrivateTmp=true

ConfigurationDirectory=xema
StateDirectory=xema/metrics
Environment=XEMA_CONFIG_DIR=/etc/xema
Environment=XEMA_SERVICE=metrics

[Install]
WantedBy=multi-user.target
