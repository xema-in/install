[Unit]
Description=Xema Manager service
# Requires=xema-fastagi.service
# After=xema-fastagi.service

[Service]
# Readiness is signalled by the app itself (AddSystemd).
Type=notify
TimeoutStartSec=300
ExecStart=/usr/bin/dotnet /var/lib/xema/manager/Manager.dll
WorkingDirectory=/var/lib/xema/manager
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-manager
PrivateTmp=true

[Install]
WantedBy=multi-user.target
