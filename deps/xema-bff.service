[Unit]
Description=Xema BFF service
After=network.target

[Service]
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /opt/techsudoku/xema/bff/Bff.dll
WorkingDirectory=/opt/techsudoku/xema/bff
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-bff
PrivateTmp=true

ConfigurationDirectory=xema
StateDirectory=xema/bff
Environment=XEMA_CONFIG_DIR=/etc/xema
Environment=XEMA_SERVICE=bff

[Install]
WantedBy=multi-user.target
