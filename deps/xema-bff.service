[Unit]
Description=Xema BFF service
After=network.target

[Service]
# Readiness is signalled by the app itself (AddSystemd).
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /var/lib/xema/bff/Bff.dll
WorkingDirectory=/var/lib/xema/bff
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-bff
PrivateTmp=true

[Install]
WantedBy=multi-user.target
