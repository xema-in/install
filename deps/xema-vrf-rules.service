[Unit]
# Reorders the routing rules so that SIP realms work at all — see the script for why, and for
# what the failure looks like when this has not run.
#
# Ordered before the network comes up so that no realm can be started against the wrong rule
# order. It is not tied to any one realm: the change is global and only has to happen once.
Description=Order the routing rules so carrier realms can be reached
Documentation=https://www.kernel.org/doc/html/latest/networking/vrf.html

DefaultDependencies=no
After=network-pre.target
Before=network.target network-online.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/xema/xema-vrf-rules.sh

[Install]
WantedBy=multi-user.target
