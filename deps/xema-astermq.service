[Unit]
Description=Xema AsterMQ service

[Service]
# Readiness is signalled by the app itself (AddSystemd).
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /var/lib/xema/astermq/AsterMQ.dll
WorkingDirectory=/var/lib/xema/astermq
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-astermq
PrivateTmp=true

[Install]
WantedBy=multi-user.target