[Unit]
Description=Xema AsterMQ service

[Service]
Type=notify
TimeoutStartSec=120
ExecStart=/usr/bin/dotnet /opt/techsudoku/xema/astermq/AsterMQ.dll
WorkingDirectory=/opt/techsudoku/xema/astermq
User=
Group=
Restart=on-failure
SyslogIdentifier=xema-astermq
PrivateTmp=true

ConfigurationDirectory=xema
StateDirectory=xema/astermq
Environment=XEMA_CONFIG_DIR=/etc/xema
Environment=XEMA_SERVICE=astermq

[Install]
WantedBy=multi-user.target